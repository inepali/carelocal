{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/archive-shifts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/compliance-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/daily-reports",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/care-score",
      "schedule": "30 6 * * *"
    }
  ]
}
